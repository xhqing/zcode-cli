# zcode-cli environment configuration template
#
# Copy this file to ~/.zcode/cli/.env and fill in your values:
#
#   mkdir -p ~/.zcode/cli && cp .env.example ~/.zcode/cli/.env
#
# On every start zcode reads that file and syncs the settings below into
# ~/.zcode/cli/config.json (the `provider` and `model` blocks of the provider
# you configure here; all other config.json content is left untouched).
# Deleting the file returns control to config.json / OAuth login.
#
# The file lives outside any repository on purpose — it holds your API key.
# Keep it mode 600 and never commit it anywhere.

# ---------------------------------------------------------------------------
# Provider identity
# ---------------------------------------------------------------------------

# Provider ID used as the key in config.json's `provider` map.
# Default: zai
#
# IMPORTANT: the upstream runtime login gate only recognizes API keys stored
# under provider ID `zai` or `bigmodel`. Any other ID produces valid model
# configuration but leaves the "Model access is not configured" login wizard
# active. Use `zai` or `bigmodel` unless you know why not.
#
# Examples:
#   zai         Z.AI Coding Plan endpoint (default)
#   bigmodel    BigModel (Zhipu) Coding Plan endpoint
#ZCODE_PROVIDER_ID=zai

# Display name shown in the TUI model picker. Default: derived from the
# provider ID (zai -> "Zai", bigmodel -> "Bigmodel").
#ZCODE_PROVIDER_NAME=Z.AI Coding Plan

# Wire protocol of the endpoint. Default: anthropic
#   anthropic          Anthropic Messages API format (Z.AI / BigModel coding plans)
#   openai-compatible  OpenAI-compatible endpoints (baseURL usually ends in /v1)
#   openai             Official OpenAI API
#ZCODE_PROVIDER_KIND=anthropic

# API root of the endpoint. Use the root, NOT a final /messages or
# /chat/completions path. Default depends on the provider ID:
#   zai      https://api.z.ai/api/anthropic
#   bigmodel https://open.bigmodel.cn/api/anthropic
# Required for any other provider ID.
#ZCODE_BASE_URL=https://api.z.ai/api/anthropic

# ---------------------------------------------------------------------------
# Credentials (required)
# ---------------------------------------------------------------------------

# API key issued by the provider. Required — a file without it is ignored.
# For Z.AI / BigModel coding plans this is the API key from the console
# (bigmodel.cn / z.ai), not an OAuth token.
#
# Multiple keys for automatic failover: uncomment and fill the numbered
# backup variables below (one key per variable). With more than one key
# zcode starts a loopback proxy (127.0.0.1, first free port from 7849) and
# retries each request with the next key on 401/403/429, 5xx or a
# connection failure. Keys themselves never leave the .env file / proxy
# memory (config.json stores only a "zcode-failover" placeholder). Switch
# events are logged to ~/.zcode/cli/key-failover.log. A single key keeps
# the direct connection.
ZCODE_API_KEY=

# Backup keys for automatic failover (optional, one key per variable):
#ZCODE_API_KEY_2=
#ZCODE_API_KEY_3=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------

# Main conversation model ID sent to the endpoint. Required.
# IDs are case-sensitive and must match what the endpoint expects
# (Z.AI / BigModel IDs are lowercase, e.g. glm-5.2).
ZCODE_MAIN_MODEL=glm-5.2

# Lightweight model used for titles, summaries and subagent work.
# Default: same as ZCODE_MAIN_MODEL.
ZCODE_LITE_MODEL=glm-5-turbo

# Extra models to declare in the picker, comma-separated. Optional.
# Each entry is a model ID, optionally `id:Display Name`:
#   glm-5.2,glm-5-turbo:Turbo
#ZCODE_EXTRA_MODELS=
